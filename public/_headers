# Netlify response headers. Read from the deployed folder, so they apply to a
# drag-and-drop upload of dist/ as well as to a Git-connected build.

# Astro fingerprints everything under /_astro/ (the hash changes with the
# content), so a browser can keep these forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
