---
import { stats, pillars } from '../data/site';

const toneMap: Record<string, { chip: string; bar: string; num: string }> = {
  yellow: { chip: 'bg-ec-yellow text-ec-ink', bar: 'bg-ec-yellow', num: 'text-ec-yellow-deep' },
  blue: { chip: 'bg-ec-blue text-ec-bone', bar: 'bg-ec-blue', num: 'text-ec-blue' },
  red: { chip: 'bg-ec-red text-ec-bone', bar: 'bg-ec-red', num: 'text-ec-red' },
};
---

<section
  id="ahora"
  data-nav-theme="light"
  class="relative isolate overflow-hidden bg-ec-bone py-24 text-ec-ink sm:py-32"
>
  <!-- Hairline grid -->
  <div class="pointer-events-none absolute inset-0 -z-10 text-ec-ink/[0.055] grid-lines" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-64 bg-gradient-to-b from-ec-bone to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-10">
    <!-- Section head -->
    <div>
      <h2 class="display text-[clamp(2.5rem,7.5vw,6.5rem)]" data-reveal>
        Está pasando<br />
        <span class="text-ec-blue">ahora mismo</span>
      </h2>
      <p class="mt-8 max-w-2xl text-[clamp(1.05rem,1.5vw,1.3rem)] leading-relaxed text-ec-ink/70" data-reveal style="--reveal-delay:120ms">
        Ecuador tiene una de las adopciones cripto más rápidas de la región y una comunidad que
        recién empieza a organizarse en serio. Ese es exactamente el momento en el que estamos:
        temprano, con espacio para todos y con mucho por armar.
      </p>
    </div>

    <!-- Counters -->
    <div class="mt-20 grid grid-cols-1 gap-px overflow-hidden rounded-3xl bg-ec-ink/12 sm:grid-cols-3">
      {
        stats.map((stat, i) => (
          <div
            class="group relative bg-ec-bone p-6 transition-colors duration-500 hover:bg-ec-ink sm:p-8"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="display text-[clamp(2.5rem,5.5vw,4.5rem)] text-ec-ink transition-colors duration-500 group-hover:text-ec-yellow">
              <span data-count={stat.value}>0</span>{stat.suffix}
            </div>
            <div class="mt-3 text-sm leading-snug text-ec-ink/60 transition-colors duration-500 group-hover:text-ec-bone/70">
              {stat.label}
            </div>
            <span
              class="absolute bottom-0 left-0 h-1 w-full origin-left scale-x-0 bg-ec-red transition-transform duration-500 group-hover:scale-x-100"
              aria-hidden="true"
            />
          </div>
        ))
      }
    </div>

    <!-- Three pillars -->
    <div class="mt-24 grid gap-6 lg:grid-cols-3">
      {
        pillars.map((p, i) => {
          const tone = toneMap[p.tone];
          return (
            <article
              class="card-lift group relative flex flex-col overflow-hidden rounded-[2rem] border border-ec-ink/12 bg-white/60 p-8 backdrop-blur-sm sm:p-10"
              data-reveal
              style={`--reveal-delay:${i * 120}ms`}
              data-hot
            >
              <span class={`sticker w-fit ${tone.chip}`} style={`transform: rotate(${i % 2 ? 2 : -2}deg)`}>
                {p.kicker}
              </span>

              <h3 class="display-wide mt-7 text-[1.6rem] leading-tight text-ec-ink">
                {p.title}
              </h3>

              <p class="mt-4 flex-1 leading-relaxed text-ec-ink/65">{p.body}</p>

              <span
                class={`mt-8 h-px w-full origin-left scale-x-0 transition-transform duration-700 [transition-timing-function:var(--ease-out-expo)] group-hover:scale-x-100 ${tone.bar}`}
                aria-hidden="true"
              />
            </article>
          );
        })
      }
    </div>
  </div>

  <!-- Diagonal handoff into the blue section -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[6vw] bg-ec-blue slice-up" aria-hidden="true"></div>
</section>
