---
import { stats, pillars } from '../data/site';

const toneMap: Record<string, { chip: string; bar: string; num: string }> = {
  yellow: { chip: 'bg-ec-yellow text-ec-ink', bar: 'bg-ec-yellow', num: 'text-ec-yellow-deep' },
  blue: { chip: 'bg-ec-blue text-ec-bone', bar: 'bg-ec-blue', num: 'text-ec-blue' },
  red: { chip: 'bg-ec-red text-ec-bone', bar: 'bg-ec-red', num: 'text-ec-red' },
};
---

<section
  id="ahora"
  data-nav-theme="light"
  class="relative isolate flex flex-col min-h-[100svh] overflow-hidden bg-ec-bone pt-[clamp(7rem,12vh,9rem)] pb-[clamp(1.5rem,4vh,3rem)] text-ec-ink"
>
  <!-- Hairline grid -->
  <div class="pointer-events-none absolute inset-0 -z-10 text-ec-ink/[0.055] grid-lines" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-64 bg-gradient-to-b from-ec-bone to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="my-auto mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
    <div class="flex flex-col lg:flex-row lg:justify-between gap-8 lg:gap-12 [@media(max-height:800px)]:!gap-4">
      <!-- Section head -->
      <div class="lg:w-7/12">
        <h2 class="display text-[clamp(1.75rem,5.5vw,5rem)] [@media(max-height:800px)]:!text-[clamp(1.5rem,6vh,3rem)] leading-tight" data-reveal>
          Está pasando<br />
          <span class="text-ec-blue whitespace-nowrap">ahora mismo</span>
        </h2>
        <p class="mt-[max(1rem,3vh)] [@media(max-height:800px)]:!mt-2 max-w-xl text-[clamp(1rem,1.5vw,1.3rem)] [@media(max-height:800px)]:!text-sm leading-relaxed text-ec-ink/70" data-reveal style="--reveal-delay:120ms">
          Ecuador tiene una de las adopciones cripto más rápidas de la región y una comunidad que
          recién empieza a organizarse en serio. Ese es exactamente el momento en el que estamos:
          temprano, con espacio para todos y con mucho por armar.
        </p>
      </div>

      <!-- Counters -->
      <div class="w-full lg:w-1/3">
        <div class="grid grid-cols-1 gap-px overflow-hidden rounded-3xl bg-ec-ink/12">
          {
            stats.map((stat, i) => (
              <div
                class="group relative bg-ec-bone p-[max(1.25rem,2.5vh)] sm:px-6 [@media(max-height:800px)]:!p-2 sm:[@media(max-height:800px)]:!px-4 transition-colors duration-500 hover:bg-ec-ink"
                data-reveal
                style={`--reveal-delay:${i * 90}ms`}
              >
                <div class="display text-[clamp(2rem,5.5vw,4.5rem)] [@media(max-height:800px)]:!text-[clamp(1.5rem,5vh,3rem)] text-ec-ink transition-colors duration-500 group-hover:text-ec-yellow">
                  <span data-count={stat.value}>0</span>{stat.suffix}
                </div>
                <div class="mt-2 [@media(max-height:800px)]:!mt-0 text-[clamp(0.8rem,1.2vh,0.875rem)] leading-snug text-ec-ink/60 transition-colors duration-500 group-hover:text-ec-bone/70">
                  {stat.label}
                </div>
                <span
                  class="absolute bottom-0 left-0 h-1 w-full origin-left scale-x-0 bg-ec-red transition-transform duration-500 group-hover:scale-x-100"
                  aria-hidden="true"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Three pillars -->
    <div class="mt-[max(1.5rem,4vh)] [@media(max-height:800px)]:!mt-4 grid gap-4 lg:gap-6 lg:grid-cols-3">
      {
        pillars.map((p, i) => {
          const tone = toneMap[p.tone];
          return (
            <article
              class="card-lift group relative flex flex-col overflow-hidden rounded-[2rem] border border-ec-ink/12 bg-white/60 p-[max(1.5rem,3.5vh)] [@media(max-height:800px)]:!p-4 backdrop-blur-sm"
              data-reveal
              style={`--reveal-delay:${i * 120}ms`}
              data-hot
            >
              <span class={`sticker w-fit ${tone.chip}`} style={`transform: rotate(${i % 2 ? 2 : -2}deg)`}>
                {p.kicker}
              </span>

              <h3 class="display-wide mt-7 [@media(max-height:800px)]:!mt-3 text-[1.6rem] [@media(max-height:800px)]:!text-[1.2rem] leading-tight text-ec-ink">
                {p.title}
              </h3>

              <p class="mt-4 [@media(max-height:800px)]:!mt-2 flex-1 leading-relaxed text-ec-ink/65 [@media(max-height:800px)]:!text-sm">{p.body}</p>

              <span
                class={`mt-8 [@media(max-height:800px)]:!mt-4 h-px w-full origin-left scale-x-0 transition-transform duration-700 [transition-timing-function:var(--ease-out-expo)] group-hover:scale-x-100 ${tone.bar}`}
                aria-hidden="true"
              />
            </article>
          );
        })
      }
    </div>
  </div>

</section>
