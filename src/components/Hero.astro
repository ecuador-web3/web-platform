---
import { brand, heroTicker } from '../data/site';
import Marquee from './Marquee.astro';
---

<section
  id="top"
  data-nav-theme="dark"
  class="bg-ec-ink"
>
  <div class="relative isolate flex flex-col min-h-[100svh] overflow-hidden pt-[max(5rem,12vh)] pb-[max(2rem,6vh)]">
    <!-- Ambient colour fields -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="blob absolute -left-[15%] top-[8%] h-[46vw] w-[46vw] bg-ec-blue/35 opacity-70 blur-3xl"></div>
      <div class="blob absolute -right-[12%] top-[42%] h-[38vw] w-[38vw] bg-ec-red/25 opacity-70 blur-3xl" style="animation-delay:-6s"></div>
      <div class="blob absolute left-[38%] -top-[18%] h-[32vw] w-[32vw] bg-ec-yellow/20 opacity-60 blur-3xl" style="animation-delay:-11s"></div>
    </div>

    <div class="my-auto relative mx-auto flex w-full max-w-[1400px] flex-col justify-center px-4 sm:px-6 lg:px-10">
      <!-- Eyebrow -->
      <div class="mb-8 flex flex-wrap items-center gap-3" data-reveal>
        <span class="sticker bg-ec-bone text-ec-ink">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ec-red opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-ec-red"></span>
          </span>
          Ecuador · {brand.coords}
        </span>
        <span class="kicker text-ec-bone/50">Bienvenido a Ecuador Web3</span>
      </div>

      <!-- Headline -->
      <h1 class="display text-[clamp(2.75rem,min(9.5vw,12vh),8rem)] text-ec-bone">
        <span class="block overflow-hidden">
          <span class="block text-ec-yellow" data-reveal style="--reveal-delay:60ms">El hogar del</span>
        </span>
        <span class="block overflow-hidden">
          <span class="block text-ec-blue-bright" data-reveal style="--reveal-delay:160ms">Ecosistema</span>
        </span>
        <span class="block overflow-hidden">
          <span class="block" data-reveal style="--reveal-delay:260ms">
            <span class="text-ec-red">Web3</span> Ecuatoriano
          </span>
        </span>
      </h1>

      <!-- Sub + CTAs -->
      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <p
          class="max-w-xl text-[clamp(1.05rem,1.6vw,1.35rem)] leading-relaxed text-ec-bone/70"
          data-reveal
          style="--reveal-delay:360ms"
        >
          {brand.promise}<br />
          <span class="text-ec-bone">{brand.motto}</span>
        </p>

        <div class="flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:440ms">
          <a href="#unete" class="btn bg-ec-yellow text-ec-ink hover:bg-ec-bone" data-magnetic="0.22">
            Únete a la comunidad
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a
            href="#eventos"
            class="btn border border-ec-bone/25 text-ec-bone hover:border-ec-bone hover:bg-ec-bone hover:text-ec-ink"
          >
            Ver próximo evento
          </a>
        </div>
      </div>

      <!-- Scroll hint -->
      <div class="mt-6 flex items-center gap-3 pb-6 text-ec-bone/35" data-reveal style="--reveal-delay:560ms">
        <svg width="18" height="26" viewBox="0 0 18 26" fill="none" class="shrink-0" aria-hidden="true">
          <rect x="1" y="1" width="16" height="24" rx="8" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="9" cy="8" r="2" fill="currentColor" class="float-slow"/>
        </svg>
        <span class="kicker">Desliza</span>
      </div>
    </div>
  </div>

  <!-- Yellow ticker seals the hero -->
  <div class="relative bg-ec-yellow text-ec-ink">
    <Marquee
      items={heroTicker}
      duration={28}
      separator="●"
      class="display py-[0.8rem] text-[clamp(1.12rem,2.72vw,2.08rem)]"
    />
  </div>
</section>
