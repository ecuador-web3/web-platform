---
import { nextEvent, seats, calls, openCalls, showOpenCalls } from '../data/site';
import Marquee from './Marquee.astro';
import { countdownFrom, padUnit } from '../lib/countdown';
import { formatEventDateRange, formatEventTime } from '../lib/eventDate';
import { seatsAt } from '../lib/seats';
import { TONE_STYLES } from '../lib/tone';

/* Seat meter and countdown are rendered server-side as the no-JS fallback and
   recomputed by the inline script on load — on a static build these values are
   only as fresh as the last deploy. */
const seatState = seatsAt(seats, Date.now());
const countdown = countdownFrom(nextEvent.startsAt, Date.now());

const ctaLabel = seatState.soldOut
  ? nextEvent.cta.soldOutLabel
  : `${nextEvent.cta.label} · quedan ${seatState.remaining}`;

const equatorTicker = [
  'Ecuador Web3', 'Mitad del Mundo', '0°0\'0"',
  'Ecuador Web3', 'Mitad del Mundo', '0°0\'0"'
];

// The lead promises convocatorias, so it has to follow the section in and out.
const lead = showOpenCalls
  ? 'Talleres, llamadas abiertas cada semana y convocatorias donde tu nombre puede entrar hoy mismo.'
  : 'Talleres y llamadas abiertas cada semana, con espacio para que tu nombre entre hoy mismo.';

const eventDateLabel = formatEventDateRange(nextEvent.startsAt, nextEvent.endsAt);

/* Conversion copy next to the meter: social proof until scarcity kicks in. */
const seatProof = seatState.soldOut
  ? 'Cupos agotados — entra a la lista'
  : seatState.remaining <= 15
    ? `Últimos ${seatState.remaining} cupos`
    : `${seatState.reserved} personas ya reservaron`;

const featuredCall = calls.find((c) => c.featured) ?? calls[0];
const otherCalls = calls.filter((c) => c !== featuredCall);
---

<section
  id="eventos"
  data-nav-theme="blue"
  class="relative isolate flex flex-col min-h-[100svh] overflow-hidden bg-ec-blue pt-[clamp(7rem,12vh,9rem)] pb-[clamp(2rem,4vh,4rem)] text-ec-bone"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="blob absolute -right-[10%] top-[6%] h-[40vw] w-[40vw] bg-ec-blue-deep/70 blur-3xl"></div>
    <div class="blob absolute -left-[14%] bottom-[4%] h-[34vw] w-[34vw] bg-ec-yellow/12 blur-3xl" style="animation-delay:-8s"></div>
  </div>

  <div class="my-auto mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
    <!-- Section head -->
    <div class="flex flex-wrap items-end justify-between gap-8 [@media(min-aspect-ratio:2/1)]:!gap-4">
      <div>
        <h2 class="display text-[clamp(2.5rem,7.5vw,6.5rem)] [@media(min-aspect-ratio:2/1)]:!text-[clamp(2rem,6vh,4rem)]" data-reveal style="--reveal-delay:80ms">
          Lo que viene
        </h2>
      </div>
      <p class="max-w-md leading-relaxed text-ec-bone/65 [@media(min-aspect-ratio:2/1)]:!text-sm" data-reveal style="--reveal-delay:160ms">
        {lead}
      </p>
    </div>

    <!-- ===== Next event: ticket ===== -->
    <div class="mt-10 sm:mt-12 lg:mt-16 [@media(min-aspect-ratio:2/1)]:!mt-6 mx-auto w-full max-w-xl md:max-w-3xl lg:max-w-4xl relative">
      <div data-reveal="scale" class="relative">
        <span
          class="sticker absolute -top-3 left-5 z-10 bg-ec-yellow text-ec-ink text-[0.65rem] md:left-8 md:text-[0.7rem]"
          style="transform: rotate(-6deg)"
        >
          Primer curso
        </span>

        <!-- Notches anchor to the card bottom, not a percentage: the stub below
             the perforation keeps a fixed height while the body above reflows. -->
        <div
          class="ticket ticket--workshop relative overflow-hidden rounded-[1.35rem] md:rounded-[1.75rem] bg-ec-bone text-ec-ink [--notch-y:calc(100%-148px)] sm:[--notch-y:calc(100%-108px)] md:[--notch-y:calc(100%-120px)] lg:[--notch-y:calc(100%-128px)] shadow-xl lg:shadow-2xl"
          data-ticket
          data-starts-at={nextEvent.startsAt}
          data-capacity={seats.capacity}
          data-anchor-at={seats.anchorAt}
          data-anchor-reserved={seats.anchorReserved}
          data-per-day={seats.perDay}
          data-cta-label={nextEvent.cta.label}
          data-cta-sold-out={nextEvent.cta.soldOutLabel}
        >
          <!-- Flag stripe: yellow / blue / red -->
          <div class="ticket-stripe absolute inset-y-0 left-0 w-[9px] md:w-3" aria-hidden="true">
            <span class="block h-1/3 bg-ec-yellow"></span>
            <span class="block h-1/3 bg-ec-blue"></span>
            <span class="block h-1/3 bg-ec-red"></span>
          </div>

          <div class="relative px-5 py-5 pl-7 sm:px-7 sm:py-6 sm:pl-9 md:px-10 md:py-8 md:pl-12 lg:px-12 lg:py-10 lg:pl-14">
            <div class="flex items-start justify-between gap-3">
              <div class="flex flex-wrap items-center gap-1.5 md:gap-2">
                <span class="kicker text-ec-ink/45 md:text-[0.7rem]">{nextEvent.code}</span>
                <span class="rounded-full bg-ec-blue/10 px-2 py-0.5 text-[0.6rem] font-medium tracking-wide text-ec-blue md:px-2.5 md:text-[0.65rem]">
                  Virtual
                </span>
                <span class="rounded-full bg-ec-yellow/25 px-2 py-0.5 text-[0.6rem] font-medium tracking-wide text-ec-ink/70 md:px-2.5 md:text-[0.65rem]">
                  2 sesiones
                </span>
                <span class="rounded-full bg-ec-red/10 px-2 py-0.5 text-[0.6rem] font-medium tracking-wide text-ec-red md:px-2.5 md:text-[0.65rem]">
                  Gratis
                </span>
              </div>
              <span class="kicker text-ec-red tabular whitespace-nowrap md:text-[0.7rem]" data-seat-label>
                <span data-seat-count>{seatState.reserved} / {seats.capacity}</span><span
                  class="hidden sm:inline"
                  data-seat-suffix>&nbsp;reservados</span
                >
              </span>
            </div>

            <div
              class="mt-3 md:mt-4 h-[5px] md:h-1.5 w-full overflow-hidden rounded-full bg-ec-ink/10"
              role="img"
              aria-label={`${seatState.reserved} de ${seats.capacity} cupos reservados`}
              data-seat-track
            >
              <div
                class="h-full rounded-full bg-gradient-to-r from-ec-yellow via-ec-blue to-ec-red transition-[width] duration-1000 [transition-timing-function:var(--ease-out-expo)]"
                style={`width:${seatState.filledPercent}%`}
                data-seat-bar
              >
              </div>
            </div>
            <p class="mt-1.5 text-[0.7rem] font-medium text-ec-red md:text-sm" data-seat-proof>
              {seatProof}
            </p>

            <h3 class="display mt-4 md:mt-6 text-[clamp(1.65rem,7vw,2.15rem)] md:text-[clamp(2.5rem,4.2vw,3.6rem)] leading-[0.9]">
              {nextEvent.title}
              <span class="block text-ec-blue">{nextEvent.accent}</span>
            </h3>

            <p class="mt-3 max-w-prose text-sm leading-snug text-ec-ink/60 md:mt-4 md:text-base md:leading-relaxed lg:text-lg">
              {nextEvent.body}
            </p>

            <!-- Motivation hooks: benefits, not decoration -->
            <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5 md:mt-5 md:gap-x-5" aria-label="Por qué inscribirte">
              {
                nextEvent.hooks.map((hook) => (
                  <li class="flex items-center gap-1.5 text-[0.7rem] font-medium text-ec-ink/70 md:text-sm">
                    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-ec-yellow" aria-hidden="true"></span>
                    {hook}
                  </li>
                ))
              }
            </ul>

            <dl class="mt-5 md:mt-7 grid grid-cols-2 gap-x-4 gap-y-3 md:grid-cols-4 md:gap-5">
              <div>
                <dt class="kicker text-ec-yellow-deep/80">Fecha</dt>
                <dd class="display-wide mt-1 text-base md:text-xl lg:text-2xl">{eventDateLabel}</dd>
              </div>
              <div>
                <dt class="kicker text-ec-blue">Hora</dt>
                <dd class="display-wide mt-1 text-base md:text-xl lg:text-2xl">{formatEventTime(nextEvent.startsAt)}</dd>
              </div>
              <div>
                <dt class="kicker text-ec-red">Modalidad</dt>
                <dd class="display-wide mt-1 text-base md:text-xl lg:text-2xl">{nextEvent.city}</dd>
              </div>
              <div>
                <dt class="kicker text-ec-ink/40">Tutores</dt>
                <dd class="mt-1 space-y-0.5 text-sm leading-tight md:text-base lg:text-lg">
                  {nextEvent.hosts.map((host) => (
                    <div class="display-wide">{host}</div>
                  ))}
                </dd>
              </div>
            </dl>
          </div>

          <div class="dashed-rule mx-5 sm:mx-7 md:mx-10 lg:mx-12 h-[2px] text-ec-ink/20" aria-hidden="true"></div>

          <div class="relative flex flex-col gap-3 px-5 py-4 pl-7 sm:flex-row sm:items-center sm:justify-between sm:px-7 sm:pl-9 md:px-10 md:pl-12 md:py-5 lg:px-12 lg:pl-14 lg:py-6">
            <div class="min-w-0">
              <div class="kicker text-ec-ink/40" data-countdown-label>
                {countdown.status === 'counting' ? 'Empieza en' : 'Sucede'}
              </div>
              <div
                class="display-wide tabular mt-0.5 text-sm md:text-lg lg:text-xl"
                data-countdown
              >
                {countdown.status === 'counting' ? (
                  <Fragment>
                    <span data-cd-days>{countdown.days}</span>d <span class="text-ec-ink/30">·</span>
                    {' '}<span data-cd-hours>{padUnit(countdown.hours)}</span>h <span class="text-ec-ink/30">·</span>
                    {' '}<span data-cd-minutes>{padUnit(countdown.minutes)}</span>m
                  </Fragment>
                ) : (
                  'Hoy mismo'
                )}
              </div>
            </div>

            <div class="flex w-full flex-col items-stretch gap-1.5 sm:w-auto sm:items-end">
              <a
                href={nextEvent.cta.href}
                class="btn ticket-cta w-full justify-center bg-ec-red text-ec-bone hover:bg-ec-ink sm:w-auto md:px-8 md:py-4 md:text-base"
                data-magnetic="0.2"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span data-seat-cta>{ctaLabel}</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <p class="text-center text-[0.65rem] text-ec-ink/45 sm:text-right md:text-xs">
                {nextEvent.cta.note}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* Ticket urgency: countdown to the event + the seat meter.

     The maths lives in src/lib so it is testable and shared with the
     server-rendered pass; this file only moves the results into the DOM.
     Config still arrives on the element as data attributes rather than by
     importing the content module, so the client bundle carries the four
     numbers it needs instead of the whole site copy. */
  import { countdownFrom, padUnit } from '../lib/countdown';
  import { seatsAt, type SeatCurve } from '../lib/seats';

  const ticket = document.querySelector<HTMLElement>('[data-ticket]');

  if (ticket) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const startsAtIso = ticket.dataset.startsAt ?? '';
    const curve: SeatCurve = {
      capacity: Number(ticket.dataset.capacity ?? 0),
      anchorAt: ticket.dataset.anchorAt ?? '',
      anchorReserved: Number(ticket.dataset.anchorReserved ?? 0),
      perDay: Number(ticket.dataset.perDay ?? 0),
    };
    const ctaLabel = ticket.dataset.ctaLabel ?? '';
    const ctaSoldOut = ticket.dataset.ctaSoldOut ?? '';

    const daysEl = ticket.querySelector('[data-cd-days]');
    const hoursEl = ticket.querySelector('[data-cd-hours]');
    const minutesEl = ticket.querySelector('[data-cd-minutes]');
    const countdownEl = ticket.querySelector('[data-countdown]');
    const countdownLabel = ticket.querySelector('[data-countdown-label]');
    const seatLabel = ticket.querySelector('[data-seat-label]');
    const seatCount = ticket.querySelector('[data-seat-count]');
    const seatSuffix = ticket.querySelector<HTMLElement>('[data-seat-suffix]');
    const seatTrack = ticket.querySelector('[data-seat-track]');
    const seatBar = ticket.querySelector<HTMLElement>('[data-seat-bar]');
    const seatCta = ticket.querySelector('[data-seat-cta]');
    const seatProof = ticket.querySelector('[data-seat-proof]');

    /* --- Countdown ----------------------------------------------------- */
    /* Returns false once the event has started, which stops the interval. */
    const paintCountdown = () => {
      const state = countdownFrom(startsAtIso, Date.now());

      if (state.status === 'started') {
        if (countdownLabel) countdownLabel.textContent = 'Sucede';
        if (countdownEl) countdownEl.textContent = 'Hoy mismo';
        return false;
      }

      if (daysEl) daysEl.textContent = String(state.days);
      if (hoursEl) hoursEl.textContent = padUnit(state.hours);
      if (minutesEl) minutesEl.textContent = padUnit(state.minutes);
      return true;
    };

    if (paintCountdown()) {
      /* 15s keeps the minute digit honest without a per-second repaint. */
      const clock = window.setInterval(() => {
        if (!paintCountdown()) window.clearInterval(clock);
      }, 15_000);
    }

    /* --- Seat meter ---------------------------------------------------- */
    const reservedNow = () => seatsAt(curve, Date.now()).reserved;

    const paintSeats = (value: number) => {
      const remaining = curve.capacity - value;
      const soldOut = remaining <= 0;
      if (seatCount) {
        seatCount.textContent = soldOut ? 'Cupos agotados' : `${value} / ${curve.capacity}`;
      }
      /* Inline style rather than a class: the suffix has to disappear at every
         breakpoint once the room is full, and `hidden sm:inline` would win. */
      if (seatSuffix) seatSuffix.style.display = soldOut ? 'none' : '';
      if (seatBar) seatBar.style.width = `${(value / curve.capacity) * 100}%`;
      if (seatTrack) {
        seatTrack.setAttribute('aria-label', `${value} de ${curve.capacity} cupos reservados`);
      }
      if (seatProof) {
        seatProof.textContent = soldOut
          ? 'Cupos agotados — entra a la lista'
          : remaining <= 15
            ? `Últimos ${remaining} cupos`
            : `${value} personas ya reservaron`;
      }
      if (seatCta) {
        seatCta.textContent = soldOut ? ctaSoldOut : `${ctaLabel} · quedan ${remaining}`;
      }
    };

    /* Starts level with what the server rendered. */
    let shown = reservedNow();

    const animateSeats = (to: number, duration: number) => {
      const from = shown;
      shown = to;
      if (reduced || from === to) {
        paintSeats(to);
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 4);
        paintSeats(Math.round(from + (to - from) * eased));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const revealMeter = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          revealMeter.unobserve(entry.target);
          /* Empty the meter here rather than at load: a browser that never
             delivers this callback then keeps the server-rendered count
             instead of being stuck advertising an empty room. */
          if (!reduced) {
            shown = 0;
            paintSeats(0);
          }
          animateSeats(reservedNow(), 1400);
        });
      },
      { threshold: 0.4 },
    );
    revealMeter.observe(ticket);

    /* The curve moves about once every 18 hours at the shipped `perDay`, so
       this rarely fires inside one visit — it exists so the number is right
       on a page left open, and so a real feed drops straight in here. */
    window.setInterval(() => {
      if (reservedNow() === shown) return;
      animateSeats(reservedNow(), 600);
      if (seatLabel instanceof HTMLElement) {
        seatLabel.classList.remove('seat-tick');
        void seatLabel.offsetWidth; /* reflow, so the animation restarts */
        seatLabel.classList.add('seat-tick');
      }
    }, 20_000);
  }
</script>

<!-- Equator slider (Marquee) -->
<div class="border-y border-ec-bone/20 bg-ec-blue-deep text-ec-yellow relative z-20">
  <Marquee
    items={equatorTicker}
    duration={35}
    separator="·"
    class="display py-5 text-[clamp(1.2rem,2.5vw,1.8rem)] tracking-widest uppercase"
  />
</div>

<section
  id="community-calls"
  data-nav-theme="blue"
  class="relative isolate flex flex-col min-h-[100svh] overflow-hidden bg-ec-blue pt-[clamp(7rem,12vh,9rem)] [@media(min-aspect-ratio:2/1)]:!pt-20 pb-[clamp(2rem,4vh,4rem)] [@media(min-aspect-ratio:2/1)]:!pb-4 text-ec-bone"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="blob absolute -left-[12%] top-[20%] h-[36vw] w-[36vw] bg-ec-yellow/10 blur-3xl"></div>
    <div class="blob absolute -right-[8%] bottom-[10%] h-[30vw] w-[30vw] bg-ec-red/10 blur-3xl" style="animation-delay:-6s"></div>
  </div>

  <div class="my-auto mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
    <div>
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="kicker text-ec-yellow mb-3">Agenda abierta</p>
          <h3 class="display text-[clamp(2.5rem,7.5vw,6.5rem)] [@media(min-aspect-ratio:2/1)]:!text-[clamp(2rem,6vh,4rem)] leading-[0.9]">
            Community<br class="sm:hidden" /> Calls
          </h3>
        </div>
        <p class="max-w-sm text-ec-bone/65 leading-relaxed [@media(min-aspect-ratio:2/1)]:!text-sm">
          Espacios semanales para aprender, preguntar y conectar. Elige la call que va contigo y entra — no hace falta CV.
        </p>
      </div>

      <div class="mt-[max(1.75rem,4vh)] [@media(min-aspect-ratio:2/1)]:!mt-4 grid gap-5 lg:grid-cols-12 lg:gap-6 lg:items-stretch">
        <!-- Featured call — primary action -->
        <article
          class="call-featured relative flex flex-col overflow-hidden rounded-[1.75rem] border border-ec-bone/15 bg-ec-blue-deep/60 p-6 sm:p-8 lg:col-span-7 lg:p-10"
          data-reveal
          style="--reveal-delay:80ms"
        >
          <div class="absolute inset-y-0 left-0 w-1.5 bg-ec-yellow" aria-hidden="true"></div>

          <div class="flex flex-wrap items-center gap-2">
            <span class="sticker bg-ec-yellow text-ec-ink" style="transform: rotate(-3deg)">
              Próxima
            </span>
            <span class={`sticker ${TONE_STYLES[featuredCall.tone].sticker}`}>
              {featuredCall.cadence}
            </span>
          </div>

          <h4 class="display mt-6 text-[clamp(2rem,4.5vw,3.5rem)] leading-[0.9] text-ec-bone">
            {featuredCall.title}
          </h4>
          <p class="mt-4 max-w-lg text-ec-bone/65 leading-relaxed sm:text-lg">
            {featuredCall.body}
          </p>

          <div class="mt-8 flex flex-wrap items-end gap-5 sm:gap-8">
            <div class="flex items-stretch gap-3" aria-label={`${featuredCall.day} a las ${featuredCall.time}`}>
              <div class="grid min-w-[4.5rem] place-items-center rounded-2xl bg-ec-yellow px-3 py-3 text-ec-ink">
                <span class="kicker text-ec-ink/55">Día</span>
                <span class="display text-2xl leading-none sm:text-3xl">{featuredCall.day}</span>
              </div>
              <div class="flex flex-col justify-center">
                <span class="kicker text-ec-bone/40">Hora · GMT-5</span>
                <span class="display-wide mt-1 text-2xl tabular text-ec-bone sm:text-3xl">{featuredCall.time}</span>
                <span class="mt-1 text-sm text-ec-bone/50">{featuredCall.where}</span>
              </div>
            </div>

            <div class="hidden h-12 w-px bg-ec-bone/15 sm:block" aria-hidden="true"></div>

            <div>
              <span class="kicker text-ec-bone/40">Para quién</span>
              <p class="mt-1 text-ec-bone/80">{featuredCall.audience}</p>
            </div>
          </div>

          <div class="mt-auto flex flex-wrap items-center gap-4 pt-8">
            <a
              href={featuredCall.href}
              class="btn bg-ec-yellow text-ec-ink hover:bg-ec-bone"
              data-magnetic="0.2"
            >
              Unirme a la call
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <p class="text-sm text-ec-bone/45">Entrada libre · micrófono abierto</p>
          </div>
        </article>

        <!-- Secondary schedule — scannable list, not twin cards -->
        <div
          class="flex flex-col rounded-[1.75rem] border border-ec-bone/15 bg-ec-ink/25 lg:col-span-5"
          data-reveal
          style="--reveal-delay:160ms"
        >
          <div class="flex items-center justify-between gap-3 border-b border-ec-bone/10 px-5 py-4 sm:px-6">
            <h4 class="kicker text-ec-bone/50">Más en la agenda</h4>
            <span class="text-xs text-ec-bone/35">{otherCalls.length} calls</span>
          </div>

          <ul class="flex flex-1 flex-col">
            {
              otherCalls.map((call, i) => (
                <li class="flex-1 border-b border-ec-bone/10 last:border-b-0">
                  <a
                    href={call.href}
                    class="call-row group flex h-full items-stretch gap-4 px-5 py-5 transition-colors duration-300 hover:bg-ec-bone/[0.06] sm:px-6 sm:py-6"
                    data-reveal
                    style={`--reveal-delay:${200 + i * 70}ms`}
                  >
                    <div class="grid w-14 shrink-0 place-content-center rounded-xl border border-ec-bone/15 bg-ec-blue-deep/80 text-center transition-colors duration-300 group-hover:border-ec-yellow/40">
                      <span class="kicker text-ec-yellow/80">{call.day}</span>
                      <span class="display-wide mt-0.5 text-sm tabular text-ec-bone">{call.time}</span>
                    </div>

                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <h5 class="display-wide text-lg leading-tight text-ec-bone transition-colors group-hover:text-ec-yellow sm:text-xl">
                          {call.title}
                        </h5>
                        <span class={`sticker scale-90 ${TONE_STYLES[call.tone].sticker}`}>
                          {call.cadence}
                        </span>
                      </div>
                      <p class="mt-1.5 line-clamp-2 text-sm leading-snug text-ec-bone/55">
                        {call.body}
                      </p>
                      <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ec-bone/40">
                        <span>{call.where}</span>
                        <span aria-hidden="true">·</span>
                        <span>{call.audience}</span>
                      </div>
                    </div>

                    <span
                      class="mt-1 grid h-8 w-8 shrink-0 place-items-center self-center rounded-full border border-ec-bone/20 text-ec-bone/40 transition-all duration-400 group-hover:border-ec-yellow group-hover:text-ec-yellow group-hover:translate-x-0.5"
                      aria-hidden="true"
                    >
                      <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
                        <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p class="mt-6 text-center text-sm text-ec-bone/40 [@media(min-aspect-ratio:2/1)]:!mt-3" data-reveal style="--reveal-delay:320ms">
        ¿Primera vez en Web3? Empieza por <a href="#unete" class="text-ec-yellow underline-offset-4 hover:underline">Onboarding 101</a>.
      </p>
    </div>

    <!-- ===== Open calls — hidden behind showOpenCalls in src/data/site.ts ===== -->
    {showOpenCalls && (
    <div id="convocatorias" class="mt-24 scroll-mt-28">
      <h3 class="display text-[clamp(1.75rem,4vw,3rem)]" data-reveal>Convocatorias abiertas</h3>

      <ul class="mt-8 border-t border-ec-bone/15">
        {
          openCalls.map((item, i) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <a
                href="#unete"
                class="group flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-ec-bone/15 py-6 transition-colors duration-400 hover:bg-ec-bone hover:text-ec-ink"
              >
                <span class="kicker w-10 shrink-0 text-ec-yellow group-hover:text-ec-red">
                  0{i + 1}
                </span>
                <span class="display-wide flex-1 text-[clamp(1.15rem,2.6vw,1.85rem)] transition-transform duration-500 [transition-timing-function:var(--ease-out-expo)] group-hover:translate-x-3">
                  {item.title}
                </span>
                <span class="kicker text-ec-bone/45 group-hover:text-ec-ink/50">{item.meta}</span>
                <span
                  class={`sticker ${
                    item.status === 'Abierta' ? 'bg-ec-yellow text-ec-ink' : 'bg-ec-red text-ec-bone'
                  }`}
                >
                  {item.status}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    )}
  </div>
</section>
