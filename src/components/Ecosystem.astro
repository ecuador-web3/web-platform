---
import { ecosystem } from '../data/site';
import { logoHeight, LOGO_BOX } from '../lib/logoSize';
import { TONE_STYLES } from '../lib/tone';
import { safeExternalUrl } from '../lib/url';

/* Partner strips use CSS marquees (GPU transform, no rAF). The pause control
   and off-screen freeze only toggle `animation-play-state` via a data attr. */
---

<section
  id="ecosistema"
  data-nav-theme="light"
  class="relative isolate flex flex-col min-h-[100svh] overflow-hidden bg-ec-bone pt-[clamp(7rem,12vh,9rem)] [@media(min-aspect-ratio:2/1)]:!pt-20 pb-[clamp(3rem,6vh,5rem)] [@media(min-aspect-ratio:2/1)]:!pb-6 text-ec-ink"
  data-ecosystem
>
  <div class="pointer-events-none absolute inset-0 -z-10 text-ec-ink/[0.05] grid-lines" aria-hidden="true"></div>

  <div class="my-auto mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
    <h2 class="display text-[clamp(2.5rem,7.5vw,6.5rem)] [@media(min-aspect-ratio:2/1)]:!text-[clamp(2rem,6vh,4rem)]" data-reveal>
      Quiénes<br /><span class="text-ec-red">construyen</span>
    </h2>

    <div class="mt-8 [@media(min-aspect-ratio:2/1)]:!mt-4 flex flex-wrap items-end justify-between gap-4" data-reveal style="--reveal-delay:120ms">
      <p class="max-w-2xl text-[clamp(1.05rem,1.5vw,1.3rem)] [@media(min-aspect-ratio:2/1)]:!text-sm leading-relaxed text-ec-ink/70">
        Nadie hace esto solo. Estas son las comunidades, universidades, cadenas y equipos que
        sostienen el ecosistema y le ponen el hombro cada mes.
      </p>

      {/* Continuous motion needs a stop for WCAG 2.2.2. Also the play control
          under reduced motion, where strips stay still until asked. */}
      <button
        type="button"
        class="kicker inline-flex shrink-0 items-center gap-2 rounded-full border-2 border-ec-ink/15 px-4 py-2 text-ec-ink/55 transition-all duration-300 hover:border-ec-ink hover:text-ec-ink"
        data-ecosystem-toggle
      >
        <span class="grid h-2.5 w-2.5 place-items-center" aria-hidden="true">
          <svg viewBox="0 0 10 10" fill="currentColor" data-toggle-pause><rect x="1" y="1" width="3" height="8" rx="1"/><rect x="6" y="1" width="3" height="8" rx="1"/></svg>
          <svg viewBox="0 0 10 10" fill="currentColor" class="hidden" data-toggle-play><path d="M2 1l7 4-7 4z"/></svg>
        </span>
        <span data-toggle-label>Pausar</span>
      </button>
    </div>
  </div>

  <div class="mt-12 [@media(min-aspect-ratio:2/1)]:!mt-5 space-y-8 [@media(min-aspect-ratio:2/1)]:!space-y-5" data-reveal style="--reveal-delay:200ms">
    {
      ecosystem.map((group, gi) => {
        const tone = TONE_STYLES[group.tone];
        const reverse = gi % 2 === 1;
        /* Duplicate once for a seamless -50% loop. */
        const track = [...group.items, ...group.items];
        const duration = Math.max(28, group.items.length * 4.5);

        return (
          <div class="eco-strip" style={`--eco-duration:${duration}s`}>
            <div class="mx-auto mb-4 flex max-w-[1400px] items-center gap-3 px-4 sm:px-6 lg:px-10">
              <span class={`sticker ${tone.sticker}`} style={`transform: rotate(${gi % 2 ? 1.5 : -1.5}deg)`}>
                {group.label}
              </span>
              <span class="h-px flex-1 bg-ec-ink/10" aria-hidden="true"></span>
            </div>

            {/* Animated strip — hidden from AT; the static list below is canonical. */}
            <div class="eco-marquee-host relative" aria-hidden="true">
              <div
                class:list={['eco-marquee', reverse && 'eco-marquee--reverse']}
              >
                {track.map((item) => {
                  const url = safeExternalUrl(item.url);
                  const inner = (
                    <>
                      <span class:list={['eco-chip-dot', tone.rule]} aria-hidden="true"></span>
                      {item.logo ? (
                        <span
                          class="flex shrink-0 items-center justify-center"
                          style={`height:${LOGO_BOX}`}
                        >
                          <img
                            src={item.logo}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="w-auto max-w-[7rem] object-contain"
                            style={`height:${logoHeight(item.logo, item.scale)}`}
                          />
                        </span>
                      ) : null}
                      <span class="display text-[clamp(1.05rem,2vw,1.45rem)] leading-none tracking-tight">
                        {item.name}
                      </span>
                    </>
                  );

                  return url ? (
                    <a
                      href={url}
                      target="_blank"
                      rel="noreferrer"
                      class="eco-chip group"
                    >
                      {inner}
                    </a>
                  ) : (
                    <div class="eco-chip group">
                      {inner}
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Accessible, static roster — also the reduced-motion view. */}
            <ul class="eco-static sr-only mx-auto max-w-[1400px] flex-wrap gap-2 px-4 sm:px-6 lg:px-10 motion-reduce:not-sr-only motion-reduce:flex">
              {group.items.map((item) => {
                const url = safeExternalUrl(item.url);
                return (
                  <li>
                    {url ? (
                      <a
                        href={url}
                        target="_blank"
                        rel="noreferrer"
                        class="eco-chip eco-chip--static"
                      >
                        <span class:list={['eco-chip-dot', tone.rule]} aria-hidden="true"></span>
                        {item.name}
                      </a>
                    ) : (
                      <span class="eco-chip eco-chip--static">
                        <span class:list={['eco-chip-dot', tone.rule]} aria-hidden="true"></span>
                        {item.name}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  /* Pause / resume only — motion itself is CSS. No animation frames. */
  const section = document.querySelector<HTMLElement>('[data-ecosystem]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section) {
    let userPaused = reduced;
    let inView = false;

    const sync = () => {
      section.toggleAttribute('data-paused', userPaused || !inView);
    };

    new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          inView = entry.isIntersecting;
          sync();
        });
      },
      { threshold: 0 },
    ).observe(section);

    const toggle = section.querySelector<HTMLElement>('[data-ecosystem-toggle]');
    const label = section.querySelector('[data-toggle-label]');
    const pauseIcon = section.querySelector('[data-toggle-pause]');
    const playIcon = section.querySelector('[data-toggle-play]');

    const paintToggle = () => {
      if (label) label.textContent = userPaused ? 'Reanudar' : 'Pausar';
      pauseIcon?.classList.toggle('hidden', userPaused);
      playIcon?.classList.toggle('hidden', !userPaused);
    };

    toggle?.addEventListener('click', () => {
      userPaused = !userPaused;
      paintToggle();
      sync();
    });

    paintToggle();
    sync();
  }
</script>
