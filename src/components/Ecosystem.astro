---
import { ecosystem } from '../data/site';
import Marquee from './Marquee.astro';

const toneMap: Record<string, { bg: string; text: string }> = {
  yellow: { bg: 'bg-ec-yellow', text: 'text-ec-ink' },
  blue: { bg: 'bg-ec-blue', text: 'text-ec-bone' },
  red: { bg: 'bg-ec-red', text: 'text-ec-bone' },
  ink: { bg: 'bg-ec-ink', text: 'text-ec-bone' },
};
---

<section
  id="ecosistema"
  data-nav-theme="light"
  class="relative isolate flex flex-col min-h-[100svh] overflow-hidden bg-ec-bone pt-[clamp(7rem,12vh,9rem)] [@media(min-aspect-ratio:2/1)]:!pt-20 pb-[clamp(2rem,4vh,4rem)] [@media(min-aspect-ratio:2/1)]:!pb-4 text-ec-ink"
>
  <div class="pointer-events-none absolute inset-0 -z-10 text-ec-ink/[0.05] grid-lines" aria-hidden="true"></div>

  <div class="my-auto w-full flex flex-col gap-8 [@media(min-aspect-ratio:2/1)]:!gap-4">
    <div class="mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-10">
      <h2 class="display text-[clamp(2.5rem,7.5vw,6.5rem)] [@media(min-aspect-ratio:2/1)]:!text-[clamp(2rem,6vh,4rem)]" data-reveal>
        Quiénes<br /><span class="text-ec-red">construyen</span>
      </h2>
      <p class="mt-8 [@media(min-aspect-ratio:2/1)]:!mt-4 max-w-2xl text-[clamp(1.05rem,1.5vw,1.3rem)] [@media(min-aspect-ratio:2/1)]:!text-sm leading-relaxed text-ec-ink/70" data-reveal style="--reveal-delay:120ms">
        Nadie hace esto solo. Estas son las comunidades, universidades, cadenas y equipos que
        sostienen el ecosistema y le ponen el hombro cada mes.
      </p>
    </div>

    <!-- Full-width Infinite Ribbons -->
    <div class="w-full shrink-0">
      {
        ecosystem.map((group, gi) => {
          const tone = toneMap[group.tone];
          const isReverse = gi % 2 !== 0;
          
          return (
            <div 
              class={`relative block border-y border-ec-ink/5 ${tone.bg} ${tone.text} transition-all duration-500 hover:z-20 hover:shadow-2xl hover:scale-[1.02] hover:[&_.marquee]:[animation-play-state:paused]`}
              data-reveal 
              style={`--reveal-delay:${gi * 100}ms`}
            >
              <!-- Category Label badge -->
              <div class="absolute left-4 top-3 sm:left-10 sm:top-4 z-30">
                <span class={`sticker shadow-sm ${tone.bg} ${tone.text} border border-current/20`}>
                  {group.label}
                </span>
              </div>

              <!-- The Marquee -->
              <Marquee
                items={group.items}
                duration={40 + (gi * 5)} 
                reverse={isReverse}
                separator="✦"
                class="display-wide pt-12 pb-4 sm:pt-11 sm:pb-4 [@media(min-aspect-ratio:2/1)]:!pt-10 [@media(min-aspect-ratio:2/1)]:!pb-2 text-[clamp(2.2rem,4vw,4rem)] [@media(min-aspect-ratio:2/1)]:!text-[clamp(1.5rem,4vh,3rem)] tracking-tight uppercase"
              />
            </div>
          );
        })
      }
    </div>
  </div>
</section>
