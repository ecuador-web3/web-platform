---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HappeningNow from '../components/HappeningNow.astro';
import NextEvent from '../components/NextEvent.astro';
import CommunityCalls from '../components/CommunityCalls.astro';
import Ecosystem from '../components/Ecosystem.astro';
import JoinMovement from '../components/JoinMovement.astro';
import Footer from '../components/Footer.astro';
import { copy, derived } from '../i18n';
---

<Base title={copy.meta.title} description={derived.metaDescription}>
  <Nav />

  <main id="contenido">
    <Hero />
    <HappeningNow />
    <NextEvent />
    <CommunityCalls />
    <Ecosystem />
    <JoinMovement />
  </main>

  <Footer />
</Base>
